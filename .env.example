# =============================================================================
#  WanderSync · variables de entorno
#  Copia este archivo a .env y completa los valores:   cp .env.example .env
#  .env está en .gitignore: NUNCA subas secretos al repositorio.
# =============================================================================

# ---------------------------------------------------------------- Base de datos
# OPCIÓN A (recomendada para la entrega): Supabase en la nube.
#   Supabase Dashboard > Connect > "Session pooler" (IPv4, puerto 5432).
#   No uses la "Direct connection" (db.<ref>.supabase.co): es solo IPv6 y
#   Docker Desktop en Windows normalmente no tiene salida IPv6.
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
PGSSL=true

# OPCIÓN B (sin internet / respaldo para la demo): Postgres local con la misma
# imagen de Supabase (trae pg_graphql). Levantar con:
#   docker compose --profile localdb up --build
# DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
# PGSSL=false
# LOCAL_DB_PASSWORD=postgres

# ------------------------------------------------------------------- Secretos
# Genera valores aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Firma de la cookie de sesión (mínimo 32 caracteres).
SESSION_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_64_CARACTERES_HEX______________
# Token compartido entre servicios internos (cabecera x-internal-token).
INTERNAL_API_TOKEN=CAMBIAR_POR_OTRO_VALOR_ALEATORIO
# true solo si se sirve por HTTPS (cookie Secure).
COOKIE_SECURE=false

# -------------------------------------------------------------------- Ingesta
# Días hacia adelante de la fecha de viaje y noches de estadía.
INGESTION_DAYS_AHEAD=30
INGESTION_NIGHTS=3
# Frecuencia de la ingesta programada (minutos) y corrida al arrancar.
INGESTION_INTERVAL_MINUTES=360
INGESTION_RUN_ON_STARTUP=true

# ----------------------------------------------------------------------- SAGA
# Pausa entre pasos de la SAGA para que se vean en vivo en la demo (segundos).
SAGA_STEP_DELAY_SECONDS=1.5

# ------------------------------------------------- URLs públicas (navegador)
PUBLIC_PREFECT_URL=http://127.0.0.1:4200
PUBLIC_DASK_URL=http://127.0.0.1:8787/status
PUBLIC_GRAPHQL_URL=http://127.0.0.1:4000/graphql
